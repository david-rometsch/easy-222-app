@startuml global-key

title GlobalKey – Cross-Widget State Access

participant "MainShell" as MS
participant "RecordPage" as RP
participant "Settings" as ST

MS -> RP : key: _recordKey
MS -> ST : recordKey: _recordKey

/'== WCA-ID updated in Settings =='/
ST -> ST : update wca-id in settings

ST -> RP : recordKey.currentState?.setState((){})
RP -> RP : _getWcaData()

@enduml

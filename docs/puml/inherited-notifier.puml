@startuml inherited-notifier

title AppLocale – InheritedNotifier Localization Flow

skinparam rectangle {
  BackgroundColor<<notifier>> LightYellow
  BackgroundColor<<inherited>> LightBlue
  BackgroundColor<<listener>> LightGreen
  BackgroundColor<<trigger>> LightSalmon
  BackgroundColor<<unchanged>> White
}

rectangle "ValueNotifier<String>\nlocaleNotifier\n('de' | 'en')" <<notifier>> as VN

rectangle "AppLocale\n(InheritedNotifier)" <<inherited>> as AL

rectangle "MaterialApp" <<unchanged>> as MA

rectangle "MainShell\n(Scaffold)" <<unchanged>> as MS

rectangle "TextButton\n(DE / EN)" <<trigger>> as TB


rectangle "RecordPage\ndependsOn: AppLocale" <<listener>> as RP

rectangle "Settings\ndependsOn: AppLocale" <<listener>> as ST

TB --> VN 
VN --> AL : notifier
AL --> MA
MA --> MS
MS --> TB
MS --> RP
MS --> ST


@enduml
